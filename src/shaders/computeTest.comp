#version 460 core

layout (local_size_x = 16, local_size_y = 16, local_size_z = 1) in;





struct Triangle{
    float V0x, V0y, V0z;
	float V1x, V1y, V1z;
	float V2x, V2y, V2z;
	float Cx, Cy, Cz; 

};

struct TriangleMaterial{
    float u0,v0;
    float u1,v1;
    float u2,v2;
    float n1x, n1y, n1z;
    float n2x, n2y, n2z;
    float n3x, n3y, n3z;

   
    int mirror;



};

struct flatRTNode {
    float aabbMinX, aabbMinY, aabbMinZ;
    int right;
    float aabbMaxX, aabbMaxY, aabbMaxZ;
    int triIndex;
};


struct Ray{
    vec3 origin;
    vec3 direction;
    float closestT;
};



layout(std430, binding = 0) buffer BVH { flatRTNode nodes[]; };
layout(std430, binding = 1) buffer Triangles { Triangle tris[]; };
layout(std430, binding = 2) buffer TrianglesTex { TriangleMaterial trisMaterial[]; };

layout(rgba32f, binding = 0) uniform image2D imgOutput;

layout(binding = 1) uniform sampler2D tex;
layout(binding = 2) uniform samplerCube  skybox;


uniform vec3 camPos;
uniform vec3 camDir;
uniform vec3 camRight;
uniform vec3 camUp;
uniform float fov;
uniform ivec2 resolution;


bool rayAABB(vec3 orig, vec3 dir, flatRTNode node, out float tNear, out float tFar)
{
    vec3 invDir = 1.0 / dir;

    vec3 t0s = vec3(
        (node.aabbMinX - orig.x) * invDir.x,
        (node.aabbMinY - orig.y) * invDir.y,
        (node.aabbMinZ - orig.z) * invDir.z
    );

    vec3 t1s = vec3(
        (node.aabbMaxX - orig.x) * invDir.x,
        (node.aabbMaxY - orig.y) * invDir.y,
        (node.aabbMaxZ - orig.z) * invDir.z
    );

    vec3 tsmaller = min(t0s, t1s);
    vec3 tbigger  = max(t0s, t1s);
    
    tNear = max(max(tsmaller.x, tsmaller.y), tsmaller.z);
    tFar  = min(min(tbigger.x, tbigger.y), tbigger.z);

    return tNear <= tFar;
}

bool rayTriangle(vec3 orig, vec3 dir, Triangle tri, out float t, out vec3 hitNormal, out vec2 uv) {

    vec3 edge1 = vec3(tri.V1x-tri.V0x,tri.V1y-tri.V0y,tri.V1z-tri.V0z);
    vec3 edge2 = vec3(tri.V2x-tri.V0x,tri.V2y-tri.V0y,tri.V2z-tri.V0z);

    vec3 pvec = cross(dir, edge2);
    float det = dot(edge1, pvec);

    if(abs(det) < 1e-8) return false;

    float invDet = 1.0 / det;
    vec3 tvec = orig - vec3(tri.V0x,tri.V0y,tri.V0z);
    uv.x = dot(tvec, pvec) * invDet;

    if(uv.x < 0.0 || uv.x > 1.0) return false;

    vec3 qvec = cross(tvec, edge1);
    uv.y = dot(dir, qvec) * invDet;

    if(uv.y < 0.0 || uv.x + uv.y > 1.0) return false;

    t = dot(edge2, qvec) * invDet;
    hitNormal = normalize(cross(edge1, edge2));

    return t > 0.0;
}


// max height of the BVH, size 32 amounts to over 2 bilion triangles
const int MAX_STACK_SIZE = 32; 

void rayTrace(inout Ray ray, out vec3 bestN, out int triIndex,out vec2 bestBarycentric)
{
    int stack[MAX_STACK_SIZE];
    int stackPtr = 0;

    stack[stackPtr++] = 0; // root

    while (stackPtr > 0)
    {
        int nodeIndex = stack[--stackPtr];
        flatRTNode node  = nodes[nodeIndex];

        float tNear, tFar;
        if (!rayAABB(ray.origin, ray.direction, node, tNear, tFar))
            continue;

        if (tNear > ray.closestT)
            continue;

        // Leaf
        if (node.triIndex >= 0)
        {
            float t;
            vec3 n;
            vec2 barycentric;
            if (rayTriangle(ray.origin, ray.direction, tris[node.triIndex], t, n,barycentric))
            {
                if (t > 0.0 && t < ray.closestT)
                {
                    ray.closestT = t;
                    bestN = n;
                    triIndex = node.triIndex;
                    bestBarycentric = barycentric;
                }
            }
            continue;
        }

        // Internal node
        int left  = nodeIndex + 1;
        int right = nodeIndex + node.right;

        float tNearL, tFarL;
        float tNearR, tFarR;

        bool hitL = rayAABB(ray.origin, ray.direction, nodes[left],  tNearL, tFarL);
        bool hitR = rayAABB(ray.origin, ray.direction, nodes[right], tNearR, tFarR);

        if (!hitL && !hitR)
            continue;

        // Near–far ordering
        int first, second;
        float tFirst, tSecond;

        if (hitL && hitR)
        {
            if (tNearL < tNearR)
            {
                first  = left;  tFirst  = tNearL;
                second = right; tSecond = tNearR;
            }
            else
            {
                first  = right; tFirst  = tNearR;
                second = left;  tSecond = tNearL;
            }
        }
        else if (hitL)
        {
            first = left;
            tFirst = tNearL;
            second = -1;
        }
        else
        {
            first = right;
            tFirst = tNearR;
            second = -1;
        }

        // Push far node only
        if (second >= 0 ) //&& stackPtr < MAX_STACK_SIZE
            stack[stackPtr++] = second;

        // Traverse near node immediately
        if (tFirst < ray.closestT)
        {
//            if (stackPtr < MAX_STACK_SIZE)
                stack[stackPtr++] = first;
        }
    }


}


bool traceShadowRay(vec3 origin, vec3 direction, float maxDist)
{
    int stack[MAX_STACK_SIZE];
    int stackPtr = 0;

    stack[stackPtr++] = 0; // root

    while (stackPtr > 0)
    {
        int nodeIndex = stack[--stackPtr];
        flatRTNode node = nodes[nodeIndex];

        float tNear, tFar;
        if (!rayAABB(origin, direction, node, tNear, tFar))
            continue;

        if (tNear > maxDist)
            continue;

        // Leaf node - test triangle
        if (node.triIndex >= 0)
        {
            float t;
            vec3 n;
            vec2 uv;
            if (rayTriangle(origin, direction, tris[node.triIndex], t, n, uv))
            {
                // If we hit anything within the distance, we're in shadow
                if (t > 0.001 && t < maxDist)
                    return true; // Early exit 
            }
            continue;
        }

        // Internal node
        int left  = nodeIndex + 1;
        int right = nodeIndex + node.right;

        float tNearL, tFarL;
        float tNearR, tFarR;

        bool hitL = rayAABB(origin, direction, nodes[left],  tNearL, tFarL);
        bool hitR = rayAABB(origin, direction, nodes[right], tNearR, tFarR);

        if (!hitL && !hitR)
            continue;

        
        int first, second;

        if (hitL && hitR)
        {
            if (tNearL < tNearR)
            {
                first  = left;
                second = right;
            }
            else
            {
                first  = right;
                second = left;
            }
            
            
            if (tNearR < maxDist || tNearL < maxDist)
            {
                stack[stackPtr++] = second;
                stack[stackPtr++] = first;
            }
        }
        else if (hitL && tNearL < maxDist)
        {
            stack[stackPtr++] = left;
        }
        else if (hitR && tNearR < maxDist)
        {
            stack[stackPtr++] = right;
        }
    }

    return false; 
}

float hash12(vec2 p)
{
    vec3 p3 = fract(vec3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}

vec2 randomOffset(vec2 seed)
{
    return vec2(
        hash12(seed),
        hash12(seed + 17.0)
    ) - 0.5;
}



void main()
{
    ivec2 dims  = imageSize(imgOutput);
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= dims.x || pixel.y >= dims.y)
        return;
    
    float aspect = float(dims.x) / float(dims.y);

    vec3  bestN    = vec3(0.0);
    vec2 bestBarycentric   = vec2(0.0);
    int triIndex;

    Ray ray;

    const int numLights = 3;

    vec3 lightPositions[numLights];
    vec3 lightColors[numLights];
    float lightIntensities[numLights];
        
    lightPositions[0] = vec3(5.0, 5.0, 5.0);
    lightColors[0] = vec3(1.0, 1.0, 1.0);
    lightIntensities[0] = 100.0;
        
    lightPositions[1] = vec3(-5.0, 5.0, 5.0);
    lightColors[1] = vec3(1.0, 0.5, 1.0);
    lightIntensities[1] = 50.0;
        
    lightPositions[2] = vec3(0.0, 7.0, 5.0);
    lightColors[2] = vec3(1.0, 1.0, 0.5);
    lightIntensities[2] = 40.0;
    
    vec4 finalColor = vec4(0.0);

    int samples = 4;
    int maxDepth = 4;

    for(int i=0; i<samples; i++)
    {
        vec2 jitter = randomOffset(vec2(pixel) + float(i));
          
        vec2 ndc = (vec2(pixel) + 0.5 + jitter) / vec2(dims) * 2.0 - 1.0;
        ndc.x *= aspect;
        
        ray.origin = camPos;
        ray.closestT = 1e30;
        ray.direction = normalize(
            camDir +
            ndc.x * camRight * tan(fov * 0.5) +
            ndc.y * camUp    * tan(fov * 0.5)
        );

        vec3 throughput = vec3(1.0); //      how much light passes through reflections/refractions

        for(int depth=0; depth<maxDepth; depth++)
        {
            rayTrace(ray, bestN, triIndex, bestBarycentric);

            if(ray.closestT == 1e30 || depth==maxDepth-1)
            { 
                finalColor += vec4(throughput * texture(skybox, ray.direction).rgb, 1.0);
                break;
            } 
            
            TriangleMaterial triMat = trisMaterial[triIndex];

            float w = 1.0 - bestBarycentric.x - bestBarycentric.y;
            
            float u = bestBarycentric.x * triMat.u0 + 
                      bestBarycentric.y * triMat.u1 + 
                      w * triMat.u2;

            float v = bestBarycentric.x * triMat.v0 + 
                      bestBarycentric.y * triMat.v1 + 
                      w * triMat.v2;

            vec3 normal = normalize(
                bestBarycentric.x * vec3(triMat.n2x, triMat.n2y, triMat.n2z) +
                bestBarycentric.y * vec3(triMat.n3x, triMat.n3y, triMat.n3z) +
                w * vec3(triMat.n1x, triMat.n1y, triMat.n1z)
            );
              
            vec3 I = ray.origin + ray.closestT * ray.direction;

            if(triMat.mirror == 0) // opaque
            {             
                vec4 albedo = texture(tex, vec2(u, v));
                vec3 totalLighting = vec3(0.0);
                vec3 ambient = albedo.xyz * 0.05;
                 
                for(int lightIndex = 0; lightIndex < numLights; lightIndex++)
                {
                    vec3 lightPos = lightPositions[lightIndex];
                    vec3 lightColor = lightColors[lightIndex];
                    float lightIntensity = lightIntensities[lightIndex];
                     
                    vec3 L = lightPos - I;
                    float dist = length(L);
                    L = L / dist;
                     
                    bool inShadow = traceShadowRay(I + normal * 0.001, L, dist);
                    float shadow = inShadow ? 0.0 : 1.0;
                
                    totalLighting += albedo.xyz * max(dot(normal, L), 0.0) * shadow * 
                                    (lightColor * lightIntensity / (dist * dist));
                }
                 
                finalColor += vec4(throughput * (ambient + totalLighting), 1.0);
                break;
            }
            else if(triMat.mirror == 1) // glass
            {
                
                
                float ior = 1.5;
                vec3 refractDir = refract(normalize(ray.direction), normal, 1.0 / ior);
                
                // If total internal reflection occurs, refract returns zero vector
                if (length(refractDir) < 0.01)
                {
                    // Total internal reflection - treat as mirror
                    ray.direction = reflect(ray.direction, normal);
                }
                else
                {
                    ray.direction = refractDir;
                }
                
                ray.origin = I + ray.direction * 0.001;
                ray.closestT = 1e30;
                
                
                throughput *= vec3(0.95, 0.95, 0.95);
                
                continue;
            }
            else if(triMat.mirror == 2) // mirror
            {
                ray.direction = reflect(ray.direction, normal);
                ray.origin = I + ray.direction * 0.001;
                ray.closestT = 1e30;
                
                
                throughput *= vec3(0.95, 0.95, 0.95);
                continue;
            }
        }
    }
   
    finalColor /= float(samples);
    imageStore(imgOutput, pixel, finalColor);
}
#version 460 core

layout (local_size_x = 1, local_size_y = 1, local_size_z = 1) in;


layout(rgba32f, binding = 0) uniform image2D imgOutput;


struct Triangle{
    float V0x, V0y, V0z;
	float V1x, V1y, V1z;
	float V2x, V2y, V2z;
	float Cx, Cy, Cz; 

};

struct flatRTNode {
    float aabbMinX, aabbMinY, aabbMinZ;
    int right;
    float aabbMaxX, aabbMaxY, aabbMaxZ;
    int triIndex;
};

bool rayAABB(vec3 orig, vec3 dir, flatRTNode node, out float tNear, out float tFar)
{
    vec3 invDir = 1.0 / dir;

    vec3 t0s = vec3(
        (node.aabbMinX - orig.x) * invDir.x,
        (node.aabbMinY - orig.y) * invDir.y,
        (node.aabbMinZ - orig.z) * invDir.z
    );

    vec3 t1s = vec3(
        (node.aabbMaxX - orig.x) * invDir.x,
        (node.aabbMaxY - orig.y) * invDir.y,
        (node.aabbMaxZ - orig.z) * invDir.z
    );

    vec3 tsmaller = min(t0s, t1s);
    vec3 tbigger  = max(t0s, t1s);
    
    tNear = max(max(tsmaller.x, tsmaller.y), tsmaller.z);
    tFar  = min(min(tbigger.x, tbigger.y), tbigger.z);

    return tNear <= tFar;
}

bool rayTriangle(vec3 orig, vec3 dir, Triangle tri, out float t, out vec3 hitNormal) {

    vec3 edge1 = vec3(tri.V1x-tri.V0x,tri.V1y-tri.V0y,tri.V1z-tri.V0z);
    vec3 edge2 = vec3(tri.V2x-tri.V0x,tri.V2y-tri.V0y,tri.V2z-tri.V0z);

    vec3 pvec = cross(dir, edge2);
    float det = dot(edge1, pvec);

    if(abs(det) < 1e-8) return false;

    float invDet = 1.0 / det;
    vec3 tvec = orig - vec3(tri.V0x,tri.V0y,tri.V0z);
    float u = dot(tvec, pvec) * invDet;

    if(u < 0.0 || u > 1.0) return false;

    vec3 qvec = cross(tvec, edge1);
    float v = dot(dir, qvec) * invDet;

    if(v < 0.0 || u + v > 1.0) return false;

    t = dot(edge2, qvec) * invDet;
    hitNormal = normalize(cross(edge1, edge2));

    return t > 0.0;
}


layout(std430, binding = 0) buffer BVH { flatRTNode nodes[]; };
layout(std430, binding = 1) buffer Triangles { Triangle tris[]; };


uniform vec3 camPos;
uniform vec3 camDir;
uniform vec3 camRight;
uniform vec3 camUp;
uniform float fov;
uniform ivec2 resolution;

// max height of the BVH, size 32 amounts to over 2 bilion triangles
 const int MAX_STACK_SIZE = 32; 



int counter = 0;

void main()
{
    ivec2 dims = imageSize(imgOutput);
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if(pixel.x >= dims.x || pixel.y >= dims.y) return;

   float aspect = float(dims.x) / float(dims.y);
   vec2 ndc = (vec2(pixel) + 0.5) / vec2(dims) * 2.0 - 1.0;

    ndc.x *= aspect;

    vec3 rayOrig = camPos;
    vec3 rayDir = normalize(camDir +
                            ndc.x * camRight * tan(fov * 0.5) +
                            ndc.y * camUp    * tan(fov * 0.5));



    vec3 color = vec3(0.0);
    float closestT = 1e30;
    vec3 bestN = vec3(0);

    float tNear, tFar;

    int stack[MAX_STACK_SIZE];
    int stackPtr = 0;
    
    stack[stackPtr++] = 0;

   while(stackPtr>0)
   {
        int nodeIndex = stack[--stackPtr];       
        if(nodes[nodeIndex].triIndex<0)
        {
           if(rayAABB(rayOrig,rayDir,nodes[nodeIndex],tNear,tFar))
           {
                stack[stackPtr++] = nodeIndex + nodes[nodeIndex].right;
                stack[stackPtr++] = nodeIndex + 1;
           }
        }
        else{
            float t;
            vec3 n;
            if(rayTriangle(rayOrig,rayDir,tris[nodes[nodeIndex].triIndex],t,n))
            {
                if (t < closestT) {
                    closestT = t;
                    bestN = n;
                }
            }
        }
   }




  
//    // brute-force intersect
//    for(int i = 0; i < tris.length(); ++i) {
//        float t;
//        vec3 n;
//
//        if(rayTriangle(rayOrig, rayDir, tris[i], t, n)) {           
//            if (t < closestT) {
//                closestT = t;
//                bestN = n;
//            }
//        }
//    }
            if (closestT < 1e29)
            color = abs(bestN);


    

    imageStore(imgOutput, pixel, vec4(color, 1.0));
}